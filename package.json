{
  "name": "gold-tracker-combined",
  "version": "1.0.0",
  "description": "Complete gold tracking system - prices + news crawler",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "tsx  src/index.ts",
    "start:prices": "tsx  src/index.ts --prices",
    "start:news": "tsx src/index.ts --news",
    "crawl:prices": "tsx src/run-once.ts",
    "crawl:news": "tsx src/crawlers/news/index.ts",
    "scheduler:prices": "tsx src/scheduler.ts",
    "scheduler:news": "tsx src/crawlers/news/scheduler.ts",
    "admin:news": "tsx src/crawlers/news/admin.ts",
    "admin:news:list": "tsx src/crawlers/news/admin.ts list",
    "admin:news:stats": "tsx src/crawlers/news/admin.ts stats",
    "admin:news:activate-all": "tsx src/crawlers/news/admin.ts activate-all",
    "archive:once": "tsx src/run-archive-once.ts",
    "test": "node test.js",
    "build": "tsc",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "gold",
    "price",
    "news",
    "crawler",
    "tracker"
  ],
  "author": "DHoang",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
